# Base URL of the mprnt-backend API, including /api/v1.
# The contact form POSTs to ${NEXT_PUBLIC_API_URL}/public/leads.
# Also added to the Content-Security-Policy connect-src at build time.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Public URL of this site, used for canonical URLs, sitemap.xml and robots.txt.
# Defaults to https://mprint.co (placeholder domain, see src/lib/site.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3005
